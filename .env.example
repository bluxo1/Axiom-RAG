# Axiom — environment template
#
# Copy to `.env` and fill in. Secrets live here and ONLY here (Rules.md §2, §5).
# Tunable knobs (thresholds, weights, k, chunk size, budget defaults) live in
# `config.yaml`, not in this file.
#
#   cp .env.example .env
#
# Every variable below is documented. `.env` is gitignored.

# ─── Runtime ──────────────────────────────────────────────────────────────────

# Which environment this process is: dev | test | prod. Affects logging only.
AXIOM_ENV=dev

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# Path to the YAML knob file, relative to the backend working directory.
CONFIG_PATH=config.yaml

# ─── LLM providers (Architecture.md §5 — swappable via llm/provider.py) ───────

# OpenAI key. Required when generation.provider or embedding.provider is `openai`.
OPENAI_API_KEY=

# Groq key. Required when generation.provider is `groq`.
GROQ_API_KEY=

# ─── Web-search fallback (Architecture.md §3.6) ───────────────────────────────

# Tavily key. Required when fallback.provider is `tavily`.
TAVILY_API_KEY=

# Brave Search key. Required when fallback.provider is `brave`.
BRAVE_API_KEY=

# ─── Datastores ───────────────────────────────────────────────────────────────

# PostgreSQL connection URL (documents, chunks, sessions, messages, spend_log).
# Inside docker compose the host is `postgres`; from your shell it is `localhost`.
DATABASE_URL=postgresql+psycopg://axiom:axiom@localhost:5432/axiom

# ChromaDB server (dev vector store, ADR-0002). Inside docker compose the host is
# `chroma` on port 8000; from your shell it is localhost on the mapped port 8001.
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── Budget guard (Prompt.md Rule 8, Design.md §6) ────────────────────────────
# These override `budget.*` in config.yaml. Exceeding any cap returns
# 429 BUDGET_EXCEEDED. Leave blank to use the config.yaml defaults.

# Hard ceiling on tokens for a single request (prompt + completion).
MAX_REQUEST_TOKENS=8000

# Total tokens allowed per calendar day across all providers.
DAILY_TOKEN_CAP=200000

# Total estimated spend allowed per calendar month, in USD.
MONTHLY_SPEND_USD=10.0

# ─── Postgres container bootstrap (docker compose only) ───────────────────────
# Used by the `postgres` service to create the role and database on first boot.
# Keep these in sync with DATABASE_URL above.
POSTGRES_USER=axiom
POSTGRES_PASSWORD=axiom
POSTGRES_DB=axiom

# ─── Frontend (Vite — only VITE_* vars reach the browser) ─────────────────────

# Base URL the browser uses to reach the API, including the version prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1
