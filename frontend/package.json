{
  "name": "axiom-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Axiom — citation-grounded RAG agent (frontend)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "scripts": {
